import json
from pathlib import Path
from openpyxl import Workbook

base_dir = Path(__file__).resolve().parent.parent
source = base_dir / 'apps' / 'api' / 'src' / 'templates' / 'finance-template.json'
output = base_dir / 'exports' / 'finance-report.xlsx'

output.parent.mkdir(parents=True, exist_ok=True)

with source.open('r', encoding='utf-8') as f:
    data = json.load(f)

wb = Workbook()
ws = wb.active
ws.title = 'Finance'
ws.append(['Category', 'Value'])
ws.append(['Balance', data.get('balance', 0)])
ws.append(['Monthly Income', data.get('monthlyIncome', 0)])
ws.append(['Monthly Expense', data.get('monthlyExpense', 0)])
ws.append(['Monthly Savings', data.get('monthlySavings', 0)])

ws2 = wb.create_sheet('Transactions')
ws2.append(['Type', 'Category', 'Amount', 'Note', 'Date'])
for tx in data.get('transactions', []):
    ws2.append([tx.get('type'), tx.get('category'), tx.get('amount'), tx.get('note', ''), tx.get('date', '')])

ws3 = wb.create_sheet('Learning')
ws3.append(['Language', 'Topic', 'Time', 'Progress'])
for item in data.get('learning', []):
    ws3.append([item.get('language'), item.get('topic'), item.get('time'), item.get('progress')])

wb.save(output)
print(f'Excel file berhasil dibuat: {output}')
